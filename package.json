{
  "name": "yunta",
  "version": "0.1.0",
  "description": "MCP server for controlled, auditable WordPress draft creation.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node entrypoints/mcp/stdio.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "mcp:stdio": "node entrypoints/mcp/stdio.ts",
    "mission:wordpress-draft": "node entrypoints/wordpress-draft/cli.ts",
    "build:windows": "node scripts/build-windows.mjs",
    "test:windows-exe": "node --test tests/mcp-windows-exe.integration.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "resedit": "3.1.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0"
  }
}
